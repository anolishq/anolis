---
# High-value signal only: keep diagnostics/analyzer/bugprone/performance, drop readability noise.
Checks: >
  clang-diagnostic-*,
  clang-analyzer-*,
  performance-*,
  bugprone-*,
  -readability-*,
  -bugprone-macro-parentheses,
  -bugprone-easily-swappable-parameters,
  -performance-enum-size
# Note: consider re-enabling specific readability checks once bugprone/perf are clean.
# Every enabled check is an error, so a finding fails `just lint` rather than
# printing beside a zero exit (#372). A check that has to stay noisy is
# disabled in Checks above, with its reason, not demoted here.
WarningsAsErrors: "*"
# Limit diagnostics to repository source roots only.
# This intentionally excludes generated files under build/core (e.g., protocol.pb.cc/.h).
HeaderFilterRegex: ".*/anolis/(core|tests)/.*"
# Generated protobuf headers/sources live in build/; clang-tidy can still see them via compile_commands,
# so we also disable clang-tidy on the protobuf target in CMake.
FormatStyle: file
...
