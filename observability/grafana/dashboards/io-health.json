{
  "annotations": {
    "list": [
      {
        "datasource": {
          "type": "influxdb",
          "uid": "${DS_INFLUXDB}"
        },
        "enable": true,
        "iconColor": "rgba(255, 96, 96, 1)",
        "name": "Mode Changes",
        "query": "from(bucket: \"anolis\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"mode_change\")\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> map(fn: (r) => ({\n      time: r._time,\n      text: \"Mode: \" + r.previous_mode + \" -> \" + r.new_mode\n    }))",
        "titleFormat": "Mode Change"
      },
      {
        "datasource": {
          "type": "influxdb",
          "uid": "${DS_INFLUXDB}"
        },
        "enable": true,
        "iconColor": "rgba(250, 176, 5, 1)",
        "name": "Watchdog Trips",
        "query": "from(bucket: \"anolis\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"anolis_device_health\")\n  |> filter(fn: (r) => r._field == \"watchdog_trip_count\")\n  |> derivative(unit: 1s, nonNegative: true)\n  |> filter(fn: (r) => r._value > 0.0)\n  |> map(fn: (r) => ({\n      time: r._time,\n      text: \"Watchdog trip: \" + r.provider_id + \"/\" + r.device_id\n    }))",
        "titleFormat": "Watchdog Trip"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "color-text"
            },
            "inspect": false
          },
          "mappings": [
            {
              "options": {
                "OK": {
                  "color": "green",
                  "index": 0
                },
                "WARNING": {
                  "color": "yellow",
                  "index": 1
                },
                "STALE": {
                  "color": "orange",
                  "index": 2
                },
                "UNAVAILABLE": {
                  "color": "red",
                  "index": 3
                },
                "UNKNOWN": {
                  "color": "blue",
                  "index": 4
                },
                "true": {
                  "color": "red",
                  "index": 5
                },
                "false": {
                  "color": "green",
                  "index": 6
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "watchdog_armed"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "true": {
                        "color": "green",
                        "index": 0,
                        "text": "ARMED"
                      },
                      "false": {
                        "color": "orange",
                        "index": 1,
                        "text": "DISARMED"
                      }
                    },
                    "type": "value"
                  }
                ]
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": false,
            "displayName": "provider_id"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "query": "from(bucket: \"anolis\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"anolis_device_health\")\n  |> filter(fn: (r) => contains(value: r[\"_field\"], set: [\"health\", \"io_ok\", \"io_failed\", \"io_retried_attempts\", \"watchdog_armed\", \"watchdog_tripped\", \"watchdog_trip_count\", \"missing\", \"excluded\"]))\n  |> filter(fn: (r) => r[\"provider_id\"] =~ /${provider_id:regex}/)\n  |> filter(fn: (r) => r[\"device_id\"] =~ /${device_id:regex}/)\n  |> last()\n  |> map(fn: (r) => ({r with _value: string(v: r._value)}))\n  |> pivot(rowKey: [\"provider_id\", \"device_id\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()",
          "refId": "A"
        }
      ],
      "title": "Device I/O & Watchdog Status (latest)",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "_start": true,
              "_stop": true,
              "_time": true,
              "_measurement": true,
              "runtime_name": true
            },
            "indexByName": {
              "provider_id": 0,
              "device_id": 1,
              "health": 2,
              "io_ok": 3,
              "io_failed": 4,
              "io_retried_attempts": 5,
              "watchdog_armed": 6,
              "watchdog_tripped": 7,
              "watchdog_trip_count": 8,
              "missing": 9,
              "excluded": 10
            },
            "renameByName": {}
          }
        }
      ],
      "type": "table"
    },
