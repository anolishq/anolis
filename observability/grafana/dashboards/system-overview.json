      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "query": "import \"date\"\n\n// Nothing is written when a runtime stops, so its last rows would stand: show\n// only runtimes that reported provider health in the range.\nlive = from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"anolis_provider_health\")\n  |> filter(fn: (r) => r[\"_field\"] == \"state\")\n  |> keep(columns: [\"runtime_name\"])\n  |> group()\n  |> distinct(column: \"runtime_name\")\n  |> findColumn(fn: (key) => true, column: \"_value\")\n\n// The state as of the end of the range: rows are written only on change, so a\n// signal unchanged since before the range is found by looking back 30d.\nfrom(bucket: v.defaultBucket)\n  |> range(start: date.sub(d: 30d, from: v.timeRangeStop), stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"anolis_signal\")\n  |> filter(fn: (r) => r[\"_field\"] == \"quality\")\n  |> filter(fn: (r) => r[\"runtime_name\"] =~ /^${runtime_name:regex}$/)\n  |> last()\n  |> filter(fn: (r) => contains(value: r.runtime_name, set: live))\n  |> group()\n  |> map(fn: (r) => ({\n    \"Runtime\": r.runtime_name,\n    \"Provider\": r.provider_id,\n    \"Device\": r.device_id,\n    \"Signal\": r.signal_id,\n    \"Quality\": r._value,\n    \"Last change\": int(v: r._time) / 1000000\n  }))",
          "refId": "A"
        }
      ],
      "title": "Signal Status",
      "type": "table"
    },
