        "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"mode_change\")\n  |> filter(fn: (r) => not exists r.runtime_name or r.runtime_name =~ /^${runtime_name:regex}$/)\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> map(fn: (r) => ({time: r._time, text: \"Mode: \" + r.previous_mode + \" -> \" + r.new_mode}))",
