{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>anolishq/renovate-config"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Bump the simulator release the quickstart downloads",
      "managerFilePatterns": ["/^docs/quickstart-simulator\\.md$/"],
      "matchStrings": ["\\nSIM=(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\\n"],
      "depNameTemplate": "anolishq/anolis-provider-sim",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ]
}
