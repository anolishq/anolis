{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://anolishq.github.io/schemas/anolis/machine/machine-profile.schema.json",
  "title": "Anolis Machine Profile Manifest",
  "description": "Contract for machine profile manifests.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "machine_id",
    "display_name",
    "runtime_profiles",
    "providers",
    "compatibility"
  ],
  "properties": {
    "schema_version": {
      "description": "Profile format version.",
      "type": "integer",
      "const": 1
    },
    "machine_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "runtime_profiles": {
      "description": "Named runtime config variants mapped to their YAML paths. 'manual' is the required default; additional variant names are free-form (install.sh handles any anolis-runtime.*.yaml).",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/relativePath"
      },
      "required": [
        "manual"
      ],
      "properties": {
        "manual": {
          "$ref": "#/definitions/relativePath"
        },
        "telemetry": {
          "$ref": "#/definitions/relativePath"
        },
        "automation": {
          "$ref": "#/definitions/relativePath"
        },
        "full": {
          "$ref": "#/definitions/relativePath"
        }
      }
    },
    "providers": {
      "description": "Provider instances and their config paths.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_-]+$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "config"
        ],
        "properties": {
          "config": {
            "$ref": "#/definitions/relativePath"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "behaviors": {
      "description": "Behavior-tree XML paths relative to the project directory.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/relativePath"
      },
      "uniqueItems": true
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expected_providers": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "check_http_script": {
          "$ref": "#/definitions/relativePath"
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime",
        "providers"
      ],
      "properties": {
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "config_contract",
            "http_contract"
          ],
          "properties": {
            "config_contract": {
              "type": "string"
            },
            "http_contract": {
              "type": "string"
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "providers": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "strategy",
              "version"
            ],
            "properties": {
              "strategy": {
                "type": "string",
                "enum": [
                  "local-build",
                  "pinned-ref",
                  "semver-range"
                ]
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "notes": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "components": {
      "description": "Pinned artifact versions read by tools/install.sh to build/install a deployment. Renovate auto-bumps repo/version pairs.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime",
        "providers"
      ],
      "properties": {
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repo",
            "version"
          ],
          "properties": {
            "repo": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "providers": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repo",
              "version"
            ],
            "properties": {
              "repo": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "optional": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "package",
              "version"
            ],
            "properties": {
              "package": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "description": "Informational machine-integration facts. Nothing may branch runtime behavior on these fields beyond presentation/interpretation; absence is always valid.",
      "properties": {
        "estop_topology": {
          "type": "string",
          "enum": [
            "power_cut",
            "signal"
          ],
          "description": "How the physical e-stop is wired. power_cut: e-stop cuts actuator-board power (software signature: device blackout, io_failed accrual, recovery on release). signal: e-stop drives the boards' ESTOP inputs (signature: estop=true in device state, bus stays alive). Both are first-class supported wirings."
        }
      }
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional presentation for an operator panel: the readings an operator watches, the automation's settings grouped and labelled, and what starting and stopping a run does. Nothing in the runtime reads it; absence is always valid. That each named signal and parameter exists is the consumer's check, not this schema's.",
      "properties": {
        "readings": {
          "type": "array",
          "description": "Signals shown large, in this order.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "signal",
              "label"
            ],
            "properties": {
              "signal": {
                "type": "string",
                "pattern": "^[^/\\s]+/[^/\\s]+/[^/\\s]+$",
                "description": "provider/device/signal"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "unit": {
                "type": "string",
                "minLength": 1
              },
              "decimals": {
                "type": "integer",
                "minimum": 0,
                "maximum": 6
              }
            }
          }
        },
        "settings": {
          "type": "array",
          "description": "Automation parameters in labelled groups.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "group",
              "items"
            ],
            "properties": {
              "group": {
                "type": "string",
                "minLength": 1
              },
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "parameter",
                    "label"
                  ],
                  "properties": {
                    "parameter": {
                      "type": "string",
                      "minLength": 1,
                      "description": "An automation parameter of the variants that run automation."
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "unit": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        },
        "actions": {
          "type": "array",
          "description": "Buttons the operator panel shows. Each increases its counter parameter by one, which a tree reads to run something once per press, such as RequestedPulseWindow (#697).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "parameter"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "description": "The button's text, such as \"Sample now\"."
              },
              "parameter": {
                "type": "string",
                "minLength": 1,
                "description": "An int64 automation parameter the press increases by one."
              }
            }
          }
        },
        "run": {
          "$ref": "#/definitions/operatorRun"
        },
        "experiment": {
          "$ref": "#/definitions/operatorRun",
          "deprecated": true,
          "description": "Deprecated alias of run, accepted for one minor release (0.9.x). A profile carries one or the other, not both."
        }
      },
      "not": {
        "required": [
          "run",
          "experiment"
        ]
      }
    }
  },
  "definitions": {
    "relativePath": {
      "type": "string",
      "minLength": 1
    },
    "operatorRun": {
      "type": "object",
      "additionalProperties": false,
      "description": "What Start run and Stop run do.",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "The heading of the run section, such as \"Batch\" or \"Print\". Default \"Run\"."
        },
        "start": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "enable": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "The groups' on switches (bool parameters): Start runs only if at least one is on; it doesn't change them."
            },
            "mode": {
              "type": "string",
              "enum": [
                "IDLE",
                "MANUAL",
                "AUTO"
              ],
              "description": "The mode entered."
            },
            "require": {
              "type": "array",
              "description": "Conditions on signals that must hold before Start runs. When one does not, Start refuses with its message.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "signal",
                  "equals",
                  "message"
                ],
                "properties": {
                  "signal": {
                    "type": "string",
                    "pattern": "^[^/\\s]+/[^/\\s]+/[^/\\s]+$",
                    "description": "provider/device/signal"
                  },
                  "equals": {
                    "type": [
                      "boolean",
                      "number",
                      "string"
                    ],
                    "description": "The value the signal must read."
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "description": "What the operator sees when the signal does not read it: the fix."
                  },
                  "when": {
                    "type": "string",
                    "minLength": 1,
                    "description": "A bool parameter, normally one of start.enable: the condition applies only while it reads true at Start. Without when, it always applies."
                  }
                }
              }
            }
          }
        },
        "stop": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "disable": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Bool parameters set false."
            },
            "mode": {
              "type": "string",
              "enum": [
                "IDLE",
                "MANUAL"
              ],
              "description": "The mode left in. Not AUTO: a Stop does not leave automation running."
            }
          }
        }
      }
    }
  }
}
