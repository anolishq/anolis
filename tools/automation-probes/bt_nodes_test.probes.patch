+// Drives the original and each rewrite through one scenario, with CallDevice
+// replaced by a recorder, and compares the call traces step by step.
+TEST_F(BTNodesTest, ProbeVocabTraceEquivalence) {
+    define_bioreactor_params(parameter_manager_);
+    struct Variant {
+        VocabFile file;
+        BT::Tree tree;
+        BT::Blackboard::Ptr bb;
+        VocabCalls calls;
+        size_t mark = 0;
+    };
+    std::vector<std::unique_ptr<Variant>> variants;
+    for (const auto& f : vocab_files()) {
+        BT::BehaviorTreeFactory factory;
+        register_runtime_nodes(factory, false);
+        if (f.proto) register_proto(factory);
+        auto v = std::make_unique<Variant>();
+        v->file = f;
+        v->bb = make_blackboard(true);
+        v->tree = factory.createTreeFromFile(f.path, v->bb);
+        variants.push_back(std::move(v));
+    }
+    g_vocab_fail.clear();
+
+    const auto set = [&](const char* name, anolis::automation::ParameterValue value) {
+        std::string err;
+        ASSERT_TRUE(parameter_manager_.set(name, value, err)) << name << ": " << err;
+    };
+    const auto tick_all = [&](int n) {
+        for (int k = 0; k < n; ++k) {
+            for (auto& v : variants) {
+                g_vocab_calls = &v->calls;
+                if (v->file.mirror) mirror_params(parameter_manager_, v->bb);
+                try {
+                    v->calls.log.push_back(std::string("ROOT ") + BT::toStr(v->tree.tickOnce()));
+                } catch (const std::exception& e) {
+                    v->calls.log.push_back(std::string("THROW ") + e.what());
+                }
+            }
+        }
+    };
+    int total_calls = 0;
+    const auto check = [&](const char* step) {
+        auto& ref = *variants.front();
+        const std::vector<std::string> ref_slice(ref.calls.log.begin() + static_cast<long>(ref.mark), ref.calls.log.end());
+        int calls = 0;
+        for (const auto& line : ref_slice) calls += line.rfind("ROOT", 0) == 0 ? 0 : 1;
+        total_calls += calls;
+        std::cout << "PROBE vocab step [" << step << "] original: " << calls << " calls\n";
+        for (const auto& line : ref_slice) {
+            if (line.rfind("ROOT SUCCESS", 0) != 0) std::cout << "    " << line << "\n";
+        }
+        for (auto& v : variants) {
+            const std::vector<std::string> slice(v->calls.log.begin() + static_cast<long>(v->mark), v->calls.log.end());
+            v->mark = v->calls.log.size();
+            if (v.get() == &ref) continue;
+            const bool same = slice == ref_slice;
+            std::cout << "  " << v->file.label << ": " << (same ? "SAME" : "DIFFERENT") << "\n";
+            if (!same) {
+                for (const auto& line : slice) std::cout << "    > " << line << "\n";
+            }
+            EXPECT_TRUE(same) << step << " " << v->file.label;
+        }
+    };
+    const auto sleep_ms = [](int ms) { std::this_thread::sleep_for(std::chrono::milliseconds(ms)); };
+
+    set("command_min_spacing_ms", int64_t{0});
+    tick_all(2);
+    check("start: everything disabled");
+
+    set("impeller_enable", true);
+    tick_all(2);
+    check("impeller on");
+
+    set("sample_startup_delay_s", int64_t{0});
+    set("sample_enable", true);
+    tick_all(2);
+    check("periodic sampler on, no startup delay");
+
+    set("dose1_startup_delay_s", int64_t{0});
+    set("dose1_enable", true);
+    tick_all(2);
+    check("dose1 on");
+
+    set("dose1_interval_s", int64_t{1});
+    tick_all(2);
+    check("dose1 schedule refused (pulse 5 s > interval 1 s)");
+
+    set("dose1_interval_s", int64_t{900});
+    tick_all(2);
+    check("dose1 schedule valid again");
+
+    set("sample_enable", false);
+    tick_all(2);
+    check("periodic sampler off");
+
+    set("sample_request_pulse_s", int64_t{1});
+    set("sample_requests", int64_t{1});
+    tick_all(2);
+    check("sample now");
+
+    sleep_ms(1200);
+    tick_all(2);
+    check("requested pulse over");
+
+    set("heater_pad_setpoint_c", 40.0);
+    set("heater_enable", true);
+    tick_all(2);
+    check("heater on at 40");
+
+    g_vocab_fail.insert("bread0/rlht0 set_tc_select");
+    set("heater_pad_setpoint_c", 41.0);
+    set("compensation_temp_c", 30.0);
+    tick_all(2);
+    check("setpoint 41 with set_tc_select failing; compensation 30 in the same tick");
+    g_vocab_fail.clear();
+
+    g_vocab_fail.insert("bread0/rlht0 set_mode");
+    set("heater_enable", false);
+    tick_all(2);
+    check("heater off with set_mode failing");
+    g_vocab_fail.clear();
