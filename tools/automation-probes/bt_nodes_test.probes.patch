+// ---- REPRO: runtime lens (uncommitted, throwaway). Real nodes, real BTRuntime, real CallRouter. ----
+#include <filesystem>
+#include <mutex>
+
+#include "automation/bt_runtime.hpp"
+#include "automation/mode_manager.hpp"
+#include "provider/i_provider_handle.hpp"
