+// (7) C6: a tree left RUNNING when the mode leaves AUTO, then AUTO again. Real tick loop.
+TEST(ReproRuntime, C6ReenterAutoWithRunningTree) {
+    using namespace anolis::automation;
+    ReproRig rig;
+    ASSERT_TRUE(rig.load("c6-sequence-with-sleep",
+                         R"(<Sequence>
+  <CallDevice device_handle="sim0/dev1" function_name="step1"/>
+  <Sleep msec="3000"/>
+  <CallDevice device_handle="sim0/dev1" function_name="step2"/>
+</Sequence>)"));
+    ASSERT_TRUE(rig.to_auto());
+    rig.provider->t0 = std::chrono::steady_clock::now();
+    const auto since = [&] {
+        return std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() -
+                                                                     rig.provider->t0)
+            .count();
+    };
+    ASSERT_TRUE(rig.runtime.start(20));
+    while (rig.provider->snapshot().empty() && since() < 2000) std::this_thread::sleep_for(std::chrono::milliseconds(5));
+    std::this_thread::sleep_for(std::chrono::milliseconds(300));
+    std::string err;
+    ASSERT_TRUE(rig.mode.set_mode(RuntimeMode::MANUAL, err)) << err;
+    std::cout << "REPRO c6 t+" << since() << "ms -> MANUAL (tree mid-Sleep); total_ticks="
+              << rig.runtime.get_health().total_ticks << " status=" << to_string(rig.runtime.status().status) << "\n";
+    std::this_thread::sleep_for(std::chrono::milliseconds(1000));
+    std::cout << "REPRO c6 t+" << since() << "ms still MANUAL; total_ticks=" << rig.runtime.get_health().total_ticks
+              << " calls so far=" << rig.provider->snapshot().size() << "\n";
+    ASSERT_TRUE(rig.mode.set_mode(RuntimeMode::AUTO, err)) << err;
+    std::cout << "REPRO c6 t+" << since() << "ms -> AUTO again\n";
+    std::this_thread::sleep_for(std::chrono::milliseconds(2600));
+    rig.runtime.stop();
+    std::cout << "REPRO c6 t+" << since() << "ms stopped; total_ticks=" << rig.runtime.get_health().total_ticks << "\n";
+    rig.dump("c6-sequence-with-sleep");
+}
