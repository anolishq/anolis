+namespace {
+
+namespace rp = anolis::deviceprovider::v1;
+
+std::string repro_value(const rp::Value& v) {
+    switch (v.kind_case()) {
+        case rp::Value::kDoubleValue:
+            return "double:" + std::to_string(v.double_value());
+        case rp::Value::kInt64Value:
+            return "int64:" + std::to_string(v.int64_value());
+        case rp::Value::kBoolValue:
+            return v.bool_value() ? "bool:true" : "bool:false";
+        case rp::Value::kStringValue:
+            return "string:" + v.string_value();
+        default:
+            return "<other>";
+    }
+}
+
+// What the provider end of CallRouter::execute_call received.
+struct ReproProvider : anolis::provider::IProviderHandle {
+    std::string id = "sim0";
+    mutable std::mutex m;
+    std::vector<std::string> log;
+    std::map<std::string, int> fail;  // function -> calls left to fail (-1 = always)
+    std::chrono::steady_clock::time_point t0 = std::chrono::steady_clock::now();
+
+    bool start() override { return true; }
+    bool is_available() const override { return true; }
+    bool stop() override { return true; }
+    bool hello(rp::HelloResponse&) override { return true; }
+    bool list_devices(std::vector<rp::Device>& devices) override {
+        rp::Device dev;
+        dev.set_device_id("dev1");
+        devices.push_back(dev);
+        return true;
+    }
+    bool describe_device(const std::string&, rp::DescribeDeviceResponse& response) override {
+        response.mutable_device()->set_device_id("dev1");
+        auto* caps = response.mutable_capabilities();
+        auto add = [&](const char* name, uint32_t fid, int arg_required) {  // -1: no arg
+            auto* fn = caps->add_functions();
+            fn->set_name(name);
+            fn->set_function_id(fid);
+            if (arg_required >= 0) {
+                auto* a = fn->add_args();
+                a->set_name("value");
+                a->set_type(rp::VALUE_TYPE_DOUBLE);
+                a->set_required(arg_required == 1);
+            }
+        };
+        add("set_opt", 1, 0);  // one OPTIONAL double argument "value"
+        add("set_req", 2, 1);  // one REQUIRED double argument "value"
+        add("noargs", 3, -1);
+        add("step1", 4, -1);
+        add("step2", 5, -1);
+        return true;
+    }
+    bool read_signals(const std::string&, const std::vector<std::string>&, rp::ReadSignalsResponse&,
+                      rp::Status_Code&) override {
+        return false;
+    }
+    bool call(const std::string& device_id, uint32_t, const std::string& function_name,
+              const std::map<std::string, rp::Value>& args, rp::CallResponse&) override {
+        std::lock_guard<std::mutex> lock(m);
+        std::string line = device_id + " " + function_name + "(";
+        bool first = true;
+        for (const auto& [k, v] : args) {
+            line += (first ? "" : ", ") + k + "=" + repro_value(v);
+            first = false;
+        }
+        line += ") nargs=" + std::to_string(args.size());
+        bool ok = true;
+        auto it = fail.find(function_name);
+        if (it != fail.end() && it->second != 0) {
+            ok = false;
+            if (it->second > 0) --it->second;
+        }
+        const auto ms =
+            std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - t0).count();
+        log.push_back("t+" + std::to_string(ms) + "ms " + line + (ok ? " -> provider OK" : " -> provider FAIL"));
+        return ok;
+    }
+    bool get_health(rp::GetHealthResponse&) override { return true; }
+    std::string last_error() const override { return "injected provider failure"; }
+    rp::Status_Code last_status_code() const override { return rp::Status_Code_CODE_INTERNAL; }
+    const std::string& provider_id() const override { return id; }
+
+    std::vector<std::string> snapshot() const {
+        std::lock_guard<std::mutex> lock(m);
+        return log;
+    }
+};
+
+// The wiring Runtime does: registry discovered from the provider, a CallRouter
+// with the mode manager attached, and a BTRuntime that populates the blackboard.
+struct ReproRig {
+    anolis::registry::DeviceRegistry registry;
+    anolis::state::StateCache state_cache{registry, 100};
+    anolis::control::CallRouter router{registry, state_cache};
+    anolis::provider::ProviderRegistry providers;
+    anolis::automation::ModeManager mode{anolis::automation::RuntimeMode::MANUAL};
+    anolis::automation::ParameterManager params;
+    std::shared_ptr<ReproProvider> provider = std::make_shared<ReproProvider>();
+    anolis::automation::BTRuntime runtime{state_cache, router, providers, mode, &params};
+    std::filesystem::path tree_path;
+
+    ReproRig() {
+        providers.add_provider("sim0", provider);
+        registry.discover_provider("sim0", *provider);
+        router.set_mode_manager(&mode, "OVERRIDE");
+    }
+    ~ReproRig() { runtime.stop(); }
+
+    bool load(const std::string& label, const std::string& body_or_root, bool full_root = false) {
+        const char* out = std::getenv("ANOLIS_REPRO_OUT");
+        const std::filesystem::path dir = out ? std::filesystem::path(out) / "trees" : std::filesystem::temp_directory_path();
+        std::filesystem::create_directories(dir);
+        tree_path = dir / (label + ".xml");
+        const std::string xml = full_root ? body_or_root
+                                          : "<root BTCPP_format=\"4\"><BehaviorTree ID=\"MainTree\">" + body_or_root +
+                                                "</BehaviorTree></root>";
+        std::ofstream(tree_path, std::ios::binary) << xml;
+        return runtime.load_tree(tree_path.string());
+    }
+    bool to_auto() {
+        std::string err;
+        return mode.set_mode(anolis::automation::RuntimeMode::AUTO, err);
+    }
+    // Direct ticks on this thread, through BTRuntime::tick().
+    std::string ticks(int n) {
+        std::string out;
+        for (int i = 0; i < n; ++i) {
+            try {
+                out += std::string(" ") + BT::toStr(runtime.tick());
+            } catch (const std::exception& e) {
+                out += std::string(" EXCEPTION[") + e.what() + "]";
+            }
+        }
+        return out;
+    }
+    void dump(const std::string& label) {
+        const auto calls = provider->snapshot();
+        std::cout << "REPRO " << label << ": provider received " << calls.size() << " call(s)\n";
+        for (const auto& c : calls) std::cout << "REPRO     " << c << "\n";
+        for (const auto& f : runtime.status().call_failures) {
+            std::cout << "REPRO     call_failures: " << f.device_handle << " " << f.function
+                      << " consecutive=" << f.consecutive_failures << " last_error=" << f.last_error << "\n";
+        }
+    }
+};
+
+void repro_case(const std::string& label, const std::string& body, int n = 1, bool full_root = false,
+                const std::function<void(ReproRig&)>& setup = nullptr) {
+    ReproRig rig;
+    if (setup) setup(rig);
+    if (!rig.load(label, body, full_root)) {
+        std::cout << "REPRO " << label << ": LOAD FAILED\n";
+        return;
+    }
+    if (!rig.to_auto()) {
+        std::cout << "REPRO " << label << ": could not enter AUTO\n";
+        return;
+    }
+    std::cout << "REPRO " << label << ": loaded; tick status:" << rig.ticks(n) << "\n";
+    rig.dump(label);
+}
