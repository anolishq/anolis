+// ---- PROBE: ReadSignal on a string signal ----
+namespace {
+struct StrSignalProvider : ReproProvider {
+    bool describe_device(const std::string& d, rp::DescribeDeviceResponse& response) override {
+        ReproProvider::describe_device(d, response);
+        auto* caps = response.mutable_capabilities();
+        auto* s = caps->add_signals();
+        s->set_signal_id("control_mode");
+        s->set_value_type(rp::VALUE_TYPE_STRING);
+        s->set_poll_hint_hz(1.0);
+        auto* t = caps->add_signals();
+        t->set_signal_id("temp");
+        t->set_value_type(rp::VALUE_TYPE_DOUBLE);
+        t->set_poll_hint_hz(1.0);
+        return true;
+    }
+    bool read_signals(const std::string&, const std::vector<std::string>&, rp::ReadSignalsResponse& response,
+                      rp::Status_Code&) override {
+        response.set_device_id("dev1");
+        auto* a = response.add_values();
+        a->set_signal_id("control_mode");
+        a->mutable_value()->set_type(rp::VALUE_TYPE_STRING);
+        a->mutable_value()->set_string_value("closed");
+        a->set_quality(rp::SignalValue_Quality_QUALITY_OK);
+        auto* b = response.add_values();
+        b->set_signal_id("temp");
+        b->mutable_value()->set_type(rp::VALUE_TYPE_DOUBLE);
+        b->mutable_value()->set_double_value(37.5);
+        b->set_quality(rp::SignalValue_Quality_QUALITY_OK);
+        return true;
+    }
+};
+}  // namespace
+
+TEST(ReproRuntime, ReadSignalOnStringSignal) {
+    anolis::registry::DeviceRegistry registry;
+    anolis::state::StateCache state_cache{registry, 100};
+    anolis::control::CallRouter router{registry, state_cache};
+    anolis::provider::ProviderRegistry providers;
+    auto provider = std::make_shared<StrSignalProvider>();
+    providers.add_provider("sim0", provider);
+    registry.discover_provider("sim0", *provider);
+    std::cout << "REPRO rs initialize=" << state_cache.initialize() << "\n";
+    state_cache.poll_once(providers);
+
+    BT::BehaviorTreeFactory factory;
+    factory.registerNodeType<anolis::automation::ReadSignalNode>("ReadSignal");
+    for (const char* sig : {"temp", "control_mode"}) {
+        auto bb = BT::Blackboard::create();
+        anolis::automation::BTServiceContext services;
+        services.state_cache = &state_cache;
+        services.call_router = &router;
+        services.provider_registry = &providers;
+        bb->set(anolis::automation::kBTServiceContextKey, services);
+        const std::string xml = std::string("<root BTCPP_format=\"4\"><BehaviorTree ID=\"MainTree\"><ReadSignal device_handle=\"sim0/dev1\" signal_id=\"") +
+                                sig + "\" value=\"{v}\" quality=\"{q}\"/></BehaviorTree></root>";
+        auto tree = factory.createTreeFromText(xml, bb);
+        const auto status = tree.tickOnce();
+        std::string v = "<unset>", q = "<unset>";
+        try { v = std::to_string(bb->get<double>("v")); } catch (...) {}
+        try { q = bb->get<std::string>("q"); } catch (...) {}
+        std::cout << "REPRO rs signal=" << sig << " status=" << BT::toStr(status) << " value=" << v << " quality=" << q << "\n";
+    }
