+struct VocabCalls {
+    std::vector<std::string> log;
+};
+VocabCalls* g_vocab_calls = nullptr;
+std::set<std::string> g_vocab_fail;  // "handle function"
+
+std::string vocab_norm(std::string args) {
+    if (args.rfind("json:", 0) == 0) args = args.substr(5);
+    try {
+        return nlohmann::json::parse(args).dump();
+    } catch (...) {
+        return "UNPARSEABLE(" + args + ")";
+    }
+}
+
+BT::NodeStatus vocab_record(const std::string& handle, const std::string& fn, const std::string& args,
+                            const std::string& reason) {
+    const bool fail = g_vocab_fail.count(handle + " " + fn) > 0;
+    g_vocab_calls->log.push_back(handle + " " + fn + " " + args + " reason=" + reason + (fail ? " FAIL" : ""));
+    return fail ? BT::NodeStatus::FAILURE : BT::NodeStatus::SUCCESS;
+}
+
+// Stand-in for CallDevice with the real node's ports: records instead of calling.
+class VocabCallDevice : public BT::SyncActionNode {
+public:
+    VocabCallDevice(const std::string& name, const BT::NodeConfig& config) : BT::SyncActionNode(name, config) {}
+    static BT::PortsList providedPorts() { return anolis::automation::CallDeviceNode::providedPorts(); }
+    BT::NodeStatus tick() override {
+        return vocab_record(getInput<std::string>("device_handle").value(),
+                            getInput<std::string>("function_name").value(),
+                            vocab_norm(getInput<std::string>("args").value_or("{}")),
+                            getInput<std::string>("reason").value_or(""));
+    }
+};
+
+// Prototype: one node type per device function, ports from the function's arguments.
+struct ProtoArg {
+    std::string name;
+    std::string type;  // int64|double|bool|string
+};
+struct ProtoFn {
+    std::string handle;
+    std::string function;
+    std::vector<ProtoArg> args;
+};
+
+class ProtoFnNode : public BT::SyncActionNode {
+public:
+    ProtoFnNode(const std::string& name, const BT::NodeConfig& config, ProtoFn fn)
+        : BT::SyncActionNode(name, config), fn_(std::move(fn)) {}
+
+    static BT::PortsList ports_for(const ProtoFn& fn) {
+        BT::PortsList ports = {
+            BT::InputPort<int64_t>("resend_s", "Send on change, and again every this many seconds (0: change only)"),
+            BT::InputPort<int64_t>("min_spacing_ms", 0, "Least time between sends"),
+            BT::InputPort<std::string>("reason", "", "Reason recorded with an ungated send")};
+        for (const auto& a : fn.args) {
+            if (a.type == "bool") {
+                ports.insert(BT::InputPort<bool>(a.name));
+            } else if (a.type == "string") {
+                ports.insert(BT::InputPort<std::string>(a.name));
+            } else {
+                ports.insert(BT::InputPort<double>(a.name));
+            }
+        }
+        return ports;
+    }
+
+    BT::NodeStatus tick() override {
+        nlohmann::json args = nlohmann::json::object();
+        for (const auto& a : fn_.args) {
+            if (a.type == "bool") {
+                args[a.name] = getInput<bool>(a.name).value();
+            } else if (a.type == "string") {
+                args[a.name] = getInput<std::string>(a.name).value();
+            } else if (a.type == "int64") {
+                args[a.name] = std::llround(getInput<double>(a.name).value());
+            } else {
+                args[a.name] = getInput<double>(a.name).value();
+            }
+        }
+        const std::string key = args.dump();
+        std::string reason = getInput<std::string>("reason").value_or("");
+        const auto resend_s = getInput<int64_t>("resend_s");
+        if (resend_s) {
+            const int64_t min_spacing_ms = getInput<int64_t>("min_spacing_ms").value_or(0);
+            const int64_t now_ms = std::chrono::duration_cast<std::chrono::milliseconds>(
+                                       std::chrono::steady_clock::now().time_since_epoch())
+                                       .count();
+            bool emit = false;
+            if (!has_last_) {
+                emit = true;
+                reason = "first";
+            } else if (key != last_key_ && now_ms - last_ms_ >= min_spacing_ms) {
+                emit = true;
+                reason = "changed";
+            } else if (*resend_s > 0 && now_ms - last_ms_ >= *resend_s * 1000) {
+                emit = true;
+                reason = "keepalive";
+            }
+            if (!emit) {
+                return BT::NodeStatus::SUCCESS;
+            }
+            has_last_ = true;
+            last_ms_ = now_ms;
+            last_key_ = key;
+        }
+        return vocab_record(fn_.handle, fn_.function, key, reason);
+    }
+
+private:
+    ProtoFn fn_;
+    bool has_last_ = false;
+    int64_t last_ms_ = 0;
+    std::string last_key_;
+};
+
+void register_proto(BT::BehaviorTreeFactory& factory, const std::string& sep = "-") {
+    const std::vector<ProtoFn> fns = {
+        {"bread0/dcmt0", "set_open_loop", {{"motor1_pwm", "int64"}, {"motor2_pwm", "int64"}}},
+        {"bread0/dcmt1", "set_open_loop", {{"motor1_pwm", "int64"}, {"motor2_pwm", "int64"}}},
+        {"bread0/rlht0", "set_periods_ms", {{"period1_ms", "int64"}, {"period2_ms", "int64"}}},
+        {"bread0/rlht0", "set_tc_select", {{"channel1_thermocouple", "int64"}, {"channel2_thermocouple", "int64"}}},
+        {"bread0/rlht0",
+         "set_pid_x10",
+         {{"kp1_x10", "int64"},
+          {"ki1_x10", "int64"},
+          {"kd1_x10", "int64"},
+          {"kp2_x10", "int64"},
+          {"ki2_x10", "int64"},
+          {"kd2_x10", "int64"}}},
+        {"bread0/rlht0", "set_mode", {{"mode", "string"}}},
+        {"bread0/rlht0", "set_setpoints", {{"setpoint1_c", "double"}, {"setpoint2_c", "double"}}},
+        {"bread0/rlht0", "set_open_duty_pct", {{"duty1_pct", "int64"}, {"duty2_pct", "int64"}}},
+        {"ezo0/ph0", "set_compensation", {{"temperature_c", "double"}}},
+        {"ezo0/do0", "set_compensation", {{"temperature_c", "double"}}},
+    };
+    for (const auto& fn : fns) {
+        std::string id = fn.handle;
+        id = id.substr(0, id.find('/')) + sep + id.substr(id.find('/') + 1) + sep + fn.function;
+        BT::TreeNodeManifest manifest{BT::NodeType::ACTION, id, ProtoFnNode::ports_for(fn), {}};
+        factory.registerBuilder(
+            manifest, [fn](const std::string& name, const BT::NodeConfig& config) -> std::unique_ptr<BT::TreeNode> {
+                return std::make_unique<ProtoFnNode>(name, config, fn);
+            });
+    }
+}
+
+void define_bioreactor_params(anolis::automation::ParameterManager& pm) {
+    using T = anolis::automation::ParameterType;
+    const auto b = [&](const char* n, bool v) { ASSERT_TRUE(pm.define(n, T::BOOL, v)); };
+    const auto i = [&](const char* n, int64_t v) { ASSERT_TRUE(pm.define(n, T::INT64, v)); };
+    const auto d = [&](const char* n, double v) { ASSERT_TRUE(pm.define(n, T::DOUBLE, v)); };
+    b("impeller_enable", false);
+    i("impeller_pwm", 100);
+    for (const std::string p : {"dose1", "dose2"}) {
+        b((p + "_enable").c_str(), false);
+        i((p + "_pwm").c_str(), 240);
+        i((p + "_startup_delay_s").c_str(), 60);
+        i((p + "_interval_s").c_str(), 900);
+        i((p + "_pulse_s").c_str(), 5);
+        i((p + "_max_pulses_per_hour").c_str(), 0);
+    }
+    b("sample_enable", false);
+    i("sample_pwm", 240);
+    i("sample_startup_delay_s", 60);
+    i("sample_interval_s", 900);
+    i("sample_pulse_s", 5);
+    i("sample_requests", 0);
+    i("sample_request_delay_s", 0);
+    i("sample_request_pulse_s", 5);
+    b("heater_enable", false);
+    d("heater_pad_setpoint_c", 0.0);
+    d("compensation_temp_c", 25.0);
+    i("command_keepalive_s", 30);
+    i("command_min_spacing_ms", 500);
+}
+
+// What the runtime change would do in populate_blackboard(): every parameter,
+// under its own name and type, on the root blackboard before each tick.
+void mirror_params(const anolis::automation::ParameterManager& pm, const BT::Blackboard::Ptr& bb) {
+    for (const auto& [name, def] : pm.get_all_definitions()) {
+        std::visit([&](const auto& v) { bb->set(name, v); }, def.value);
+    }
+}
+
+void register_runtime_nodes(BT::BehaviorTreeFactory& factory, bool real_call_device) {
+    factory.registerNodeType<anolis::automation::ReadSignalNode>("ReadSignal");
+    if (real_call_device) {
+        factory.registerNodeType<anolis::automation::CallDeviceNode>("CallDevice");
+    } else {
+        factory.registerNodeType<VocabCallDevice>("CallDevice");
+    }
+    factory.registerNodeType<anolis::automation::CheckQualityNode>("CheckQuality");
+    factory.registerNodeType<anolis::automation::GetParameterNode>("GetParameter");
+    factory.registerNodeType<anolis::automation::GetParameterBoolNode>("GetParameterBool");
+    factory.registerNodeType<anolis::automation::GetParameterInt64Node>("GetParameterInt64");
+    factory.registerNodeType<anolis::automation::CheckBoolNode>("CheckBool");
+    factory.registerNodeType<anolis::automation::PeriodicPulseWindowNode>("PeriodicPulseWindow");
+    factory.registerNodeType<anolis::automation::RequestedPulseWindowNode>("RequestedPulseWindow");
+    factory.registerNodeType<anolis::automation::EmitOnChangeOrIntervalNode>("EmitOnChangeOrInterval");
+    factory.registerNodeType<anolis::automation::BuildArgsJsonNode>("BuildArgsJson");
+}
+
+struct VocabFile {
+    const char* label;
+    std::string path;
+    bool mirror;
+    bool proto;
+};
+
+std::vector<VocabFile> vocab_files() {
+    const char* orig = std::getenv("ANOLIS_VOCAB_ORIG");
+    const char* dir = std::getenv("ANOLIS_VOCAB_DIR");
+    EXPECT_NE(orig, nullptr);
+    EXPECT_NE(dir, nullptr);
+    const std::string d = dir ? dir : "";
+    return {{"original", orig ? orig : "", false, false},
+            {"v1_builtins_flat", d + "/v1_builtins_flat.xml", false, false},
+            {"v1_builtins_subtrees", d + "/v1_builtins_subtrees.xml", false, false},
+            {"v2_params_on_blackboard", d + "/v2_params_on_blackboard.xml", true, false},
+            {"v3_device_function_nodes", d + "/v3_device_function_nodes.xml", true, true}};
+}
