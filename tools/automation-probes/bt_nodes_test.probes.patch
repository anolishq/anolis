+namespace {
+std::string repro_gate_tree(int keepalive_s, const std::string& fn = "set_opt") {
+    return R"(<ReactiveSequence>
+  <EmitOnChangeOrInterval key="k1" keepalive_s=")" +
+           std::to_string(keepalive_s) + R"(" emit="{emit}" reason="{r}"/>
+  <Fallback>
+    <Sequence>
+      <CheckBool value="{emit}" expected="true"/>
+      <ForceSuccess>
+        <CallDevice device_handle="sim0/dev1" function_name=")" +
+           fn + R"(" args='json:{"value":25.0}' reason="{r}"/>
+      </ForceSuccess>
+    </Sequence>
+    <AlwaysSuccess/>
+  </Fallback>
+</ReactiveSequence>)";
+}
