+              << " active=" << bb->get<bool>("active") << " idx=" << bb->get<int64_t>("idx") << "\n";
+    bb->set<int64_t>("iv", 1);  // refused: pulse_s > interval_s
+    const auto s3 = tree.tickOnce();
+    std::cout << "REPRO c3 tick3 invalid schedule (pulse 2 > interval 1): status=" << BT::toStr(s3)
+              << " active=" << bb->get<bool>("active") << "\n";
+}
