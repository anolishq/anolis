+// Runs the real tick loop at 20 Hz for `run_ms` (or until FAULT) and reports.
+void repro_loop_case(const std::string& label, const std::string& body, int fail_calls, int run_ms,
+                     const std::string& fn = "set_opt") {
+    using namespace anolis::automation;
+    ReproRig rig;
+    rig.provider->fail[fn] = fail_calls;
+    ASSERT_TRUE(rig.load(label, body));
+    ASSERT_TRUE(rig.to_auto());
+    rig.provider->t0 = std::chrono::steady_clock::now();
+    ASSERT_TRUE(rig.runtime.start(20));
+    const auto deadline = std::chrono::steady_clock::now() + std::chrono::milliseconds(run_ms);
+    while (std::chrono::steady_clock::now() < deadline && rig.mode.current_mode() == RuntimeMode::AUTO) {
+        std::this_thread::sleep_for(std::chrono::milliseconds(10));
+    }
+    const auto ran_ms = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() -
+                                                                              rig.provider->t0)
+                            .count();
+    const auto mode = rig.mode.current_mode();
+    rig.runtime.stop();
+    std::cout << "REPRO " << label << ": ran " << ran_ms << " ms, total_ticks=" << rig.runtime.get_health().total_ticks
+              << ", mode at end=" << mode_to_string(mode) << ", last_error='" << rig.runtime.get_health().last_error
+              << "'\n";
+    rig.dump(label);
+}
