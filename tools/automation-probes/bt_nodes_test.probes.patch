+// Loads each tree with the node types the runtime registers (real CallDevice),
+// counts nodes, and ticks it once against an empty device registry.
+TEST_F(BTNodesTest, ProbeVocabLoadAndCount) {
+    define_bioreactor_params(parameter_manager_);
+    for (const auto& f : vocab_files()) {
+        BT::BehaviorTreeFactory factory;
+        register_runtime_nodes(factory, true);
+        if (f.proto) register_proto(factory);
+        try {
+            auto bb = make_blackboard(true);
+            auto tree = factory.createTreeFromFile(f.path, bb);
+            size_t n = 0;
+            std::map<std::string, int> by_type;
+            tree.applyVisitor([&](BT::TreeNode* node) {
+                ++n;
+                ++by_type[node->registrationName()];
+            });
+            std::ostringstream types;
+            for (const auto& [t, c] : by_type) types << " " << t << "=" << c;
+            g_vocab_calls = new VocabCalls();
+            g_vocab_fail.clear();
+            if (f.mirror) mirror_params(parameter_manager_, bb);
+            std::string tick;
+            try {
+                tick = BT::toStr(tree.tickOnce());
+            } catch (const std::exception& e) {
+                tick = std::string("THROW ") + e.what();
+            }
+            std::cout << "PROBE vocab load " << f.label << ": nodes=" << n << " first_tick=" << tick << " |" << types.str()
+                      << "\n";
+            delete g_vocab_calls;
+            g_vocab_calls = nullptr;
+        } catch (const std::exception& e) {
+            std::cout << "PROBE vocab load " << f.label << ": EXCEPTION " << e.what() << "\n";
+            ADD_FAILURE();
+        }
+    }
+}
